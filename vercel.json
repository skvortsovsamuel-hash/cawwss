{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "services": {
        "frontend": {
            "root": "frontend",
            "framework": "create-react-app"
        },
        "backend": {
            "root": "backend",
            "framework": "fastapi",
            "entrypoint": "server.py"
        }
    },
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": {
                "service": "backend"
            }
        },
        {
            "source": "/:path*",
            "destination": {
                "service": "frontend"
            }
        }
    ]
}
